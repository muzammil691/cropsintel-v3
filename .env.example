# CropsIntel V3 — Environment Variables Reference
# Copy this file to .env for local development.
# Production values are set in Railway / Supabase Vault — never commit real secrets.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://hzrnohsxigrqlmzegwlb.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=hzrnohsxigrqlmzegwlb
SUPABASE_ACCESS_TOKEN=

# ── Anthropic (server-side only — NEVER VITE_ prefix) ────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Twilio WhatsApp ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+971...

# ── Agent (Railway service: cropsintel-agent) ─────────────────────────────────
AGENT_SSH_PRIVATE_KEY=           # Full private key for git push access
REPO_URL=git@github.com:muzammil691/cropsintel-v3.git
SLEEP_SECONDS=300                # Loop interval (default 5 min)
AGENT_DEFAULT_MODEL=claude-opus-4-7
CLAUDE_TIMEOUT_SECONDS=1800      # Max seconds Claude runs per task (default 30 min)

# ── Verifier gate (cropsintel-agent) ──────────────────────────────────────────
VERIFIER_URL=https://rare-happiness-production.up.railway.app
VERIFIER_API_TOKEN=
VERIFIER_GATE_ENABLED=true
VERIFIER_FAIL_CONFIDENCE_THRESHOLD=0.3   # Block threshold (lowered from 0.7 in phase-1.10o)
VERIFIER_TIMEOUT_SECONDS=60

# ── Remediation loop cap (cropsintel-agent) ────────────────────────────────────
MAX_REMEDIATION_ATTEMPTS=3       # After N failed remediations, escalate to WhatsApp instead

# ── Designer gate (cropsintel-agent) ─────────────────────────────────────────
DESIGNER_URL=https://designer-production.up.railway.app
DESIGNER_API_TOKEN=
DESIGNER_GATE_ENABLED=true
DESIGNER_FAIL_CONFIDENCE_THRESHOLD=0.7
DESIGNER_TIMEOUT_SECONDS=60
